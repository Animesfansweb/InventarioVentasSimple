# Copia este archivo a .env y ajusta valores (el archivo .env no debe subirse a Git).
# En producción nunca uses contraseñas en texto plano en el repositorio: usa secretos del orquestador o CI.

DB_HOST=mysql
# Dentro de Docker el servicio MySQL escucha en 3306. Desde tu PC (DBeaver, etc.) usa el puerto publicado en compose (ej. 3310).
DB_PORT=3306
DB_NAME=inventario
DB_USER=inventario
DB_PASS=
